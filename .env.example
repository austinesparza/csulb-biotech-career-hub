# Copy to .env.local and fill from Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only current Supabase secret key. NEVER prefix with NEXT_PUBLIC_.
# The legacy SUPABASE_SERVICE_ROLE_KEY name remains a temporary code fallback.
# Scope this variable to Production only in Vercel. Preview deployments are
# deliberately blocked from using any privileged Supabase key.
SUPABASE_SECRET_KEY=your-sb-secret-key

# Vercel Cron sends this value as an Authorization bearer token. Generate at
# least 32 random characters and scope it to Production only.
CRON_SECRET=
# Keep each daily invocation bounded. The route clamps this to 1-10.
PIPELINE_BATCH_LIMIT=5

# Extraction is private and opt-in. Leave disabled until a model passes the
# real officer-labelled evaluation gate. Remote models require explicit opt-in.
PIPELINE_MODEL_ENABLED=false
PIPELINE_MODEL_NAME=
PIPELINE_MODEL_BASE_URL=http://127.0.0.1:20128/v1
PIPELINE_MODEL_API_KEY=
PIPELINE_ALLOW_REMOTE_MODEL=false

# Optional fetch fallbacks. Scrapling belongs in a private worker with a
# browser installed; ScrapeGraph is a separately budgeted hosted fallback.
PIPELINE_SCRAPLING_ENABLED=false
SCRAPEGRAPH_API_KEY=
SCRAPEGRAPH_MONTHLY_BUDGET=1

# Required only for governed USAJOBS sources. Both values stay server-only.
USAJOBS_API_KEY=
USAJOBS_REGISTERED_EMAIL=

# Optional recurring web and LinkedIn lead discovery. Enable only on a Brave
# subscription whose terms explicitly grant result-storage rights.
DISCOVERY_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false
EMPLOYER_DISCOVERY_BATCH_SIZE=1
EMPLOYER_DISCOVERY_RESULTS_PER_QUERY=5

# Governed Google Sheet review mirror. Share only this workbook with the
# service-account address as Editor. Keep the private key server-only.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE='Review Queue'!A1:Z500
# Resolved rows are copied here before removal from Review Queue. If omitted,
# the application uses an Archive tab and creates it on the first queue sync.
GOOGLE_SHEETS_ARCHIVE_RANGE='Archive'!A1:Z5000
GOOGLE_SHEETS_SOURCE_RECORD_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Weekly officer-review digest. Keep OAuth credentials and recipients in
# production secrets, never in committed files or preview deployments.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Development and acceptance tests: one personal officer address only.
# Do not use a club mailbox or distribution list until production approval.
REVIEW_DIGEST_RECIPIENTS=
REVIEW_DIGEST_FROM=
REVIEW_DASHBOARD_URL=
