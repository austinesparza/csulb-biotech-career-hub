# Copy to .env.local and fill from Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only current Supabase secret key. NEVER prefix with NEXT_PUBLIC_.
# The legacy SUPABASE_SERVICE_ROLE_KEY name remains a temporary code fallback.
SUPABASE_SECRET_KEY=your-sb-secret-key

# Weekly officer-review digest. Keep OAuth credentials and recipients in
# production secrets, never in committed files or preview deployments.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Development and acceptance tests: one personal officer address only.
# Do not use a club mailbox or distribution list until production approval.
REVIEW_DIGEST_RECIPIENTS=
REVIEW_DIGEST_FROM=
REVIEW_DASHBOARD_URL=
