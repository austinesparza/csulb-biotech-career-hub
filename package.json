{
  "name": "csulb-biotech-career-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pipeline": "node --import tsx src/__tests__/pipeline/all.ts",
    "test:digest": "node --test scripts/review-digest.test.mjs",
    "test:publish-data": "node --test scripts/publish-reviewed-data.test.mjs",
    "test:schema": "node scripts/check-migration-release.mjs && node scripts/check-pipeline-schema.mjs",
    "data:historical": "node scripts/export-historical-directory.mjs",
    "ops:doctor": "node --conditions=react-server --import tsx scripts/ops-doctor.ts",
    "tools:install": "node scripts/tools/install.mjs",
    "tools:check": "node scripts/tools/check.mjs",
    "graphify:build": ".tools/graphify/bin/graphify extract . --code-only --out . && .tools/graphify/bin/graphify cluster-only . --no-label",
    "graphify:update": ".tools/graphify/bin/graphify extract . --code-only --out . && .tools/graphify/bin/graphify cluster-only . --no-label",
    "graphify:check": ".tools/graphify/bin/graphify diagnose multigraph --json",
    "graphify:query": ".tools/graphify/bin/graphify query",
    "graphify:path": ".tools/graphify/bin/graphify path",
    "graphify:explain": ".tools/graphify/bin/graphify explain",
    "graphify:affected": ".tools/graphify/bin/graphify affected",
    "graphify:god-nodes": ".tools/graphify/bin/graphify god-nodes",
    "omniroute:version": ".tools/omniroute/node_modules/.bin/omniroute --version",
    "omniroute:start": ".tools/omniroute/node_modules/.bin/omniroute serve --no-open --daemon",
    "omniroute:doctor": ".tools/omniroute/node_modules/.bin/omniroute doctor",
    "omniroute:stop": ".tools/omniroute/node_modules/.bin/omniroute stop",
    "ingest:worker": "node --conditions=react-server --import tsx scripts/run-ingestion-worker.ts",
    "extract:worker": "node --conditions=react-server --import tsx scripts/run-extraction-worker.ts",
    "sources:verify": "node --conditions=react-server --import tsx scripts/verify-starter-sources.ts",
    "discovery:plan": "node --conditions=react-server --import tsx scripts/plan-employer-discovery.ts",
    "discovery:worker": "node --conditions=react-server --import tsx scripts/run-discovery-worker.ts",
    "discovery:recall": "node --conditions=react-server --import tsx scripts/report-discovery-recall.ts",
    "verify:worker": "node --conditions=react-server --import tsx scripts/run-verification-worker.ts",
    "verify:eval": "node --conditions=react-server --import tsx scripts/evaluate-posting-verification.ts",
    "shadow:export": "node --conditions=react-server --import tsx scripts/export-shadow-bundle.ts",
    "shadow:label": "node --conditions=react-server --import tsx scripts/label-shadow-bundle.ts",
    "shadow:run": "node --conditions=react-server --import tsx scripts/run-shadow-cycle.ts"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.47.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.8",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
